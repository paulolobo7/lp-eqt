# Serviços simulados (padrão). Use "false" para ligar os adapters reais em src/lib/services/real.
USE_MOCKS=true

# Número do WhatsApp do bot, só dígitos com DDI e DDD (ex.: 55DDNNNNNNNNN). Vazio = placeholder {{NUMERO_WHATSAPP}}.
WHATSAPP_NUMERO=

# Token de verificação do webhook (GET /api/whatsapp/webhook). Combine com o painel da Meta.
WHATSAPP_VERIFY_TOKEN=

# Segredo compartilhado do POST do webhook (header x-webhook-token ou ?token=).
# Em produção é obrigatório: sem ele o webhook falha fechado.
WHATSAPP_WEBHOOK_SECRET=

# Chave da OpenAI (opcional). Sem ela, o bot usa regras locais; com ela, respostas generativas e transcrição de áudio.
OPENAI_API_KEY=
# Modelo de transcrição de áudio (opcional). Padrão: whisper-1.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# WAHA (WhatsApp HTTP API): envio das respostas. Sem URL, o webhook só devolve as mensagens.
WAHA_API_URL=
WAHA_API_KEY=
# Debounce de mensagens picotadas em ms (0 desliga). Padrão: 6500.
WAHA_BUFFER_MS=6500

# Segredo para assinar os selos (HMAC). Gere um valor longo e aleatório em produção.
# Em produção é obrigatório; sem ele o build/runtime falham de propósito.
BADGE_SECRET=

# URL pública, para links compartilháveis e prévias (OG). Na Vercel, VERCEL_PROJECT_PRODUCTION_URL é usada se esta ficar vazia.
NEXT_PUBLIC_SITE_URL=
