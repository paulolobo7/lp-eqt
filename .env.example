# Serviços simulados (padrão). Use "false" para ligar os adapters reais em src/lib/services/real.
USE_MOCKS=true

# Número do WhatsApp do bot, só dígitos com DDI e DDD (ex.: 55DDNNNNNNNNN). Vazio = placeholder {{NUMERO_WHATSAPP}}.
WHATSAPP_NUMERO=

# Token de verificação do webhook (GET /api/whatsapp/webhook). Combine com o painel da Meta.
WHATSAPP_VERIFY_TOKEN=

# Chave da OpenAI para o bot responder com IA generativa (opcional, sem ela usa regras locais)
OPENAI_API_KEY=

# Segredo para assinar os selos (HMAC). Gere um valor longo e aleatório em produção.
BADGE_SECRET=

# URL pública, para os links de prévia (OG). Na Vercel, VERCEL_PROJECT_PRODUCTION_URL é usada se esta ficar vazia.
NEXT_PUBLIC_SITE_URL=
